#!/usr/bin/env bash
set -euo pipefail

resolve_launcher() {
  local path=$1 target
  case "$path" in /*) ;; *) path=$PWD/$path ;; esac
  while [ -L "$path" ]; do
    target=$(readlink "$path")
    case "$target" in
      /*) path=$target ;;
      *) path=$(dirname "$path")/$target ;;
    esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$path")" && pwd -P)" "$(basename "$path")"
}

launcher=$(resolve_launcher "${BASH_SOURCE[0]}")
prefix_root=$(cd "$(dirname "$launcher")/.." && pwd -P)
install_root=${AGK_TERMINAL_ROOT:-$prefix_root/lib/agk-terminal}
# USER is not guaranteed to exist in SSH, systemd, gateway, or exec-based
# launches. The native TUI uses AGK_ENVIRONMENT to select control.db rows, so
# derive it from the effective Linux identity unless explicitly overridden.
if [ -z "${AGK_ENVIRONMENT:-}" ]; then
  case "$(id -un)" in
    operator|agentik|mission|private) AGK_ENVIRONMENT=$(id -un) ;;
    *)
      # Single-user installs (macOS, existing Linux profiles) declare their
      # scope in environment.yaml; mirror agk_control.Environment.current().
      agk_env_config=${AGK_ENV_CONFIG:-$HOME/.config/agk/environment.yaml}
      AGK_ENVIRONMENT=$(sed -n 's/^environment:[[:space:]]*\([a-z]*\).*/\1/p' \
        "$agk_env_config" 2>/dev/null | head -n 1 || true)
      AGK_ENVIRONMENT=${AGK_ENVIRONMENT:-agentik}
      ;;
  esac
fi
export AGK_ENVIRONMENT
export AGK_TERMINAL_ROOT=$install_root
export PATH="$install_root/bin:$HOME/.local/bin:$PATH"

case "${1:-}" in
  client)
    shift
    if [ -x "$install_root/venv/bin/python" ]; then
      exec "$install_root/venv/bin/python" "$install_root/scripts/client_control.py" "$@"
    fi
    exec python3 "$install_root/scripts/client_control.py" "$@"
    ;;
  provider|composio|hermes|topology|doctor)
    exec agk-terminal "$@"
    ;;
  version|-V|--version)
    commit=$(cat "$install_root/.agk-commit" 2>/dev/null || true)
    echo "AGK-TUI ${commit:-unknown commit} · $install_root"
    exit 0
    ;;
  help|-h|--help)
    cat <<'EOF'
AGK-TUI · RMUX control plane

Interactive:
  agk

Sessions:
  agk {status|sessions|projects|agents|os|mcp|skills|rules|system}
  agk new TYPE NAME [--cwd PATH] [--client ID] [--project ID]
  agk specialist start AGENT_ID
  agk {open|resume|info|archive|restart} SESSION
  agk close SESSION --yes
  agk kill SESSION --yes
  agk purge SESSION --yes
  agk rename SESSION NAME
  agk fork SESSION NAME
  agk reconcile

Setup and health:
  agk --version
  agk doctor
  agk client {bootstrap|init|list|show|doctor|integrations|linear|discord|work|run}
  agk provider {list|verify|install} [PROVIDER]
  agk composio {login|connect|connections|list|search|status} ...
  agk hermes {sync [--all]|update|install-shared|gateway}
  agk topology {detect|status|resolve|apply|refresh}
EOF
    exit 0
    ;;
esac

if [ "$#" -eq 0 ] && [ -x "$install_root/bin/agk-tui" ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    exec "$install_root/bin/agk-tui"
  fi
  # Supervise the interactive TUI: a crash must not strand the user in a
  # bare shell with every session still running behind it. A normal quit or
  # a deliberate signal ends the loop; repeated fast crashes stop retrying.
  crashes=0
  while :; do
    started=$SECONDS
    status=0
    "$install_root/bin/agk-tui" || status=$?
    case "$status" in
      0|129|130|143) exit "$status" ;;
    esac
    if [ $((SECONDS - started)) -ge 60 ]; then
      crashes=0
    fi
    crashes=$((crashes + 1))
    if [ "$crashes" -ge 3 ]; then
      echo "AGK stopped unexpectedly (exit $status) and keeps failing." >&2
      echo "Sessions are still running in RMUX. Details: ~/.agentik/logs/agk-tui.log" >&2
      exit "$status"
    fi
    echo "AGK stopped unexpectedly (exit $status); reopening…" >&2
    sleep 1
  done
fi
if [ -x "$install_root/venv/bin/python" ]; then
  exec "$install_root/venv/bin/python" "$install_root/scripts/agk_control.py" "$@"
fi
exec "$install_root/scripts/agk_control.py" "$@"
