{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agk.internal/schemas/onboarding_ledger.schema.json",
  "title": "AGK OS Onboarding Ledger",
  "description": "Deterministic record of a new-OS onboarding: discovery, up to 20 canonical sources (books, videos, web), up to 20 extracted approaches, the merge matrix that reconciles them into one system, and the four owner validation gates (plan, orchestration, programming, agentic) that must all be validated before START/build.",
  "type": "object",
  "additionalProperties": false,
  "required": ["os_id", "theme", "sources", "approaches", "merge_matrix", "validation_gates"],
  "properties": {
    "schema": {"type": "string", "const": "agk.onboarding-ledger.v1"},
    "os_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "theme": {"type": "string", "minLength": 3},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mission_statement": {"type": "string"},
        "actor": {"type": "string"},
        "outcome": {"type": "string"},
        "method": {"type": "string"},
        "scopes": {"type": "array", "items": {"enum": ["operator", "agentik", "mission", "private"]}},
        "existing_capabilities_reused": {"type": "array", "items": {"type": "string"}},
        "explicit_exclusions": {"type": "array", "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "title", "url", "access_level", "why_canonical"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[0-9]{2}$"},
          "kind": {"enum": ["book", "video", "web", "paper", "standard", "documentation", "course", "podcast"]},
          "title": {"type": "string", "minLength": 1},
          "author": {"type": "string"},
          "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
          "url": {"type": "string", "pattern": "^https?://"},
          "access_level": {"enum": ["full-text", "official-metadata", "official-excerpt", "transcript", "abstract", "secondary"]},
          "why_canonical": {"type": "string", "minLength": 5},
          "bestseller_signal": {"type": "string"},
          "librarian_ref": {"type": "string"}
        }
      }
    },
    "approaches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approach_id", "source_ids", "principle", "mechanism", "evidence_strength", "limitations"],
        "properties": {
          "approach_id": {"type": "string", "pattern": "^APR-[0-9]{2}$"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[0-9]{2}$"}},
          "principle": {"type": "string", "minLength": 3},
          "mechanism": {"type": "string", "minLength": 3},
          "evidence_strength": {"enum": ["strong", "moderate", "weak", "anecdotal"]},
          "limitations": {"type": "string"},
          "contradicts": {"type": "array", "items": {"type": "string", "pattern": "^APR-[0-9]{2}$"}}
        }
      }
    },
    "merge_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approach_id", "decision", "folds_into"],
        "properties": {
          "approach_id": {"type": "string", "pattern": "^APR-[0-9]{2}$"},
          "decision": {"enum": ["adopt", "adapt", "merge", "reject", "defer"]},
          "merged_with": {"type": "array", "items": {"type": "string", "pattern": "^APR-[0-9]{2}$"}},
          "folds_into": {
            "type": "array",
            "items": {"enum": ["skills", "programs", "evals", "workflows", "doctor", "recovery", "automations", "agents", "contracts", "knowledge", "commands", "memory"]}
          },
          "conflicts_with": {"type": "array", "items": {"type": "string", "pattern": "^APR-[0-9]{2}$"}},
          "resolution": {"type": "string"}
        }
      }
    },
    "validation_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "orchestration", "programming", "agentic"],
      "properties": {
        "plan": {"$ref": "#/$defs/gate"},
        "orchestration": {"$ref": "#/$defs/gate"},
        "programming": {"$ref": "#/$defs/gate"},
        "agentic": {"$ref": "#/$defs/gate"}
      }
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_version": {"type": "string"},
        "plan_path": {"type": "string"},
        "goal_contract": {"type": "object"},
        "quality_gates": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "presented", "validated", "rejected"]},
        "validated_by": {"type": "string"},
        "validated_at": {"type": "string"},
        "evidence": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
