{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentik.local/schemas/media-os/1.0.0/approval.schema.json",
  "title": "Media OS Publication Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "campaign_id", "artifact_sha256", "platform", "account_id", "publication_mode", "scheduled_at", "connector_version", "preview_ref", "approved_by", "approved_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "platform": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "publication_mode": {"type": "string", "enum": ["immediate", "scheduled", "private_stage", "unlisted"]},
    "scheduled_at": {"type": ["string", "null"], "format": "date-time"},
    "connector_version": {"type": "string", "minLength": 1},
    "preview_ref": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
